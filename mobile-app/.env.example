# API Configuration
API_URL=http://localhost:5000
WS_URL=http://localhost:5000
SMS_SERVICE_URL=http://localhost:5002

# Firebase Configuration (для push notifications)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-app
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abc123

# Google Services (для Android)
GOOGLE_SERVICES_JSON_PATH=./google-services.json

# Apple Services (для iOS)
GOOGLESERVICE_INFO_PLIST_PATH=./GoogleService-Info.plist

# Environment
NODE_ENV=development

# Encryption
ENCRYPTION_KEY_SIZE=2048

# Bluetooth Mesh
BLUETOOTH_MESH_ENABLED=true
BLUETOOTH_MAX_HOPS=5
BLUETOOTH_SCAN_INTERVAL=30000

# Features Flags
FEATURE_VIDEO_CALLS=false
FEATURE_VOICE_MESSAGES=true
FEATURE_FILE_SHARING=true
FEATURE_BLUETOOTH_MESH=true
FEATURE_AI_MODERATION=true

# Debug
DEBUG_MODE=true
LOG_LEVEL=debug
